# DeepSight local / CI database configuration.
#
# Three URLs, three roles, on purpose. The separation is what satisfies the brief's
# "the owner/superuser role must never appear in application code": in a deployed
# environment DATABASE_URL_OWNER is set ONLY on the migration pre-deploy step, so the
# owner credential is not present in any runtime process.

# Superuser. Used by `pnpm db:bootstrap` only — creating roles requires superuser.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deepsight

# deepsight_owner. Migrations, seeds and schema lint. Never application code.
DATABASE_URL_OWNER=postgres://deepsight_owner:owner_local_only@127.0.0.1:5432/deepsight

# deepsight_app. Every application query path, and every integration test.
DATABASE_URL=postgres://deepsight_app:app_local_only@127.0.0.1:5432/deepsight

DATABASE_POOL_MAX=10
LOG_LEVEL=info

# --- Phase 2: ingestion core ---

# BullMQ, and from Phase 6 also dashboard sessions and Socket.io fan-out.
REDIS_URL=redis://127.0.0.1:6379

# Service-to-service signing. Dual keys so rotation needs no coordinated restart:
# verify against current AND previous, sign with current. Rotation is
# previous <- current, current <- new, redeploy.
SERVICE_SECRET_CURRENT=local-current-secret
SERVICE_SECRET_CURRENT_KID=k2
SERVICE_SECRET_PREVIOUS=local-previous-secret
SERVICE_SECRET_PREVIOUS_KID=k1

# Interim protection for /admin routes until Phase 7 (supervisor sessions + RBAC).
# Absent -> /admin routes return 503 and refuse to serve; they never fail open.
ADMIN_API_TOKEN=local-admin-token-change-me-0123456789

PORT=8080
# Railway private networking requires the IPv6 wildcard; 0.0.0.0 is silently unreachable
# from sibling services.
BIND_HOST=::
