# DeepSight local / CI database configuration.
#
# Three URLs, three roles, on purpose. The separation is what satisfies the brief's
# "the owner/superuser role must never appear in application code": in a deployed
# environment DATABASE_URL_OWNER is set ONLY on the migration pre-deploy step, so the
# owner credential is not present in any runtime process.

# Superuser. Used by `pnpm db:bootstrap` only — creating roles requires superuser.
ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/deepsight

# deepsight_owner. Migrations, seeds and schema lint. Never application code.
DATABASE_URL_OWNER=postgres://deepsight_owner:owner_local_only@127.0.0.1:5432/deepsight

# deepsight_app. Every application query path, and every integration test.
DATABASE_URL=postgres://deepsight_app:app_local_only@127.0.0.1:5432/deepsight

DATABASE_POOL_MAX=10
LOG_LEVEL=info
