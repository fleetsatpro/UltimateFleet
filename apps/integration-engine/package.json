{
  "name": "@deepsight/integration-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/index.js --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@deepsight/config-env": "workspace:*",
    "@deepsight/contracts": "workspace:*",
    "@deepsight/db": "workspace:*",
    "@deepsight/observability": "workspace:*",
    "@deepsight/queue": "workspace:*",
    "@deepsight/resilience": "workspace:*",
    "@deepsight/vendor-adapters": "workspace:*",
    "express": "^4.21.2",
    "uuidv7": "^1.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@deepsight/test-support": "workspace:*",
    "@types/express": "^4.17.21",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.7.2",
    "esbuild": "^0.24.2"
  }
}
